[Unit]
Description=DocsFlow Queue Worker
After=redis.service mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/docflow
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --max-time=3600 --timeout=90
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=docflow-queue

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/docflow/storage

# Resource Limits
LimitNOFILE=32768
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target